# dependencies
node_modules/
# python sidecar bytecode (extractor/, transcriber/)
__pycache__/

# server-owned data — lives on the droplet, never in git
gallery/
thumbnails/
backups/
# watched-folder drop zone (bind-mounted into the app) — keep the dir, not the files
ingest-root/*
!ingest-root/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# local scratch / tooling state (settings.local.json holds credentials)
.claude/
pets-test/
emma-test/
resumes-test/

# compose secrets/overrides — .env.example is the template
.env

# personal deploy config for the author's own instance (deploy.ps1 reads it)
deploy.local.json

# personal working files — kept locally, not part of the published project
ui-redesign-taxonomy.md
tags.json
*.zip

# personal deploy tooling — stays local
deploy.ps1
