# Copy to .env (gitignored) and fill in. Every value has a working local default.

# --- site ---
# Real hostname enables automatic HTTPS via Caddy, e.g. SITE_ADDRESS=example.com
# Leave as :80 for plain-http local use.
SITE_ADDRESS=:80
# Published ports. Use high ports locally if 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
# Absolute URL used in minted invite links and alert-webhook links back into
# the gallery, e.g. https://example.com
BASE_URL=http://localhost
# Set to 0 when serving over plain http so auth cookies work.
COOKIE_SECURE=1

# --- app ---
# Optional: seeded as an admin account on startup. Not required — a fresh
# instance's login page creates the admin account on first visit (email +
# password; the first visitor claims the instance).
ADMIN_EMAIL=
# AI tagging (optional — the worker idles without a key; can also be set in the admin UI).
ANTHROPIC_API_KEY=
MODEL=
# Days to keep live-field movement history (written only on boards with
# "retag on new data" enabled). 0 keeps it forever.
SNAPSHOT_RETENTION_DAYS=90
# Days to keep tag-judgment history (deduped — only real judgment changes are
# stored, so this defaults to keeping it forever). 0 keeps it forever.
TAG_SNAPSHOT_RETENTION_DAYS=0
# Days to keep the per-board job log (the jobs view's history: transcriptions,
# ingest runs, and later the tagging legs). 0 keeps it forever.
JOB_LOG_RETENTION_DAYS=30
# Days to keep the usage meter (per-day AI spend rollup: calls, token buckets,
# per capability/provider/model). It IS the billing record and a rollup stays
# small, so the default keeps it forever.
USAGE_METER_RETENTION_DAYS=0

# Where rates for models no rung has priced are learned from — LiteLLM's
# community map, fetched at runtime (nothing is vendored; the fetch only
# happens when an unpriced model is actually metered, then refreshes every
# MODEL_PRICE_REFRESH_DAYS). Empty disables the community rung — the
# air-gapped answer; admin, provider, and descriptor prices still apply.
MODEL_PRICE_SOURCE_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
MODEL_PRICE_REFRESH_DAYS=7

# --- optional on-server engines ---
# The two heavy sidecars are opt-in. A plain `docker compose up -d` runs the
# app, its database and the extractor (~3.5GB); each engine below adds its own
# image and the models baked into it:
#   transcribe  the whisper sidecar, +~1.2GB  — speech to text, on-device
#   detect      the LLMDet sidecar,  +~3GB    — objects in images, on-device
# List the ones this host should run, comma-separated (empty = neither):
#   COMPOSE_PROFILES=transcribe,detect
# Without one, its capability reads "unavailable" on the admin Capabilities
# tab — which also names any paid provider you could bind instead. Nothing
# fails or is billed for the gap: audio simply waits untranscribed.
COMPOSE_PROFILES=

# --- transcription (whisper sidecar — needs the `transcribe` profile above) ---
# Model accuracy/CPU dial — baked into the image, so changing it is a rebuild
# (docker compose build transcriber). base is lighter but weak on non-English.
WHISPER_MODEL=small
# Bake several models and boards can pick between them (the app default stays
# WHISPER_MODEL above). Costs image weight per model — small ~0.5GB, medium
# ~1.5GB — and only one is ever resident in RAM. Empty = just WHISPER_MODEL.
# Measured: medium is markedly more accurate on real speech, ~3x slower.
BAKE_MODELS=
# Pin the spoken language (ISO code, e.g. ro/de/fr) when the library is one
# language; empty auto-detects per file from the first 30 seconds.
WHISPER_LANGUAGE=
# Beam width: 5 = accuracy default, 1 = fastest. CPU-bound knob.
WHISPER_BEAM=5
# Speaker diarization (sherpa-onnx, models baked into the transcriber image):
# transcript turns gain relative "S1"/"S2" speaker labels. 0 disables the pass.
WHISPER_DIARIZE=1
# Clustering threshold for unknown speaker count — lower splits voices more
# readily (a noisy one-voice phone clip fragments into phantom speakers),
# higher merges them (distinct voices collapse into one around 0.9). 0.8
# measured as the sweet spot; nudge per library and re-transcribe to compare.
WHISPER_DIARIZE_THRESHOLD=0.8

# --- automatic ingestion ---
# Watched folders live under ./ingest-root on the host (bind-mounted into the
# app at /data/ingest — boards pick a subfolder in the ingestion modal).
# Tunables (code owns the defaults; leave empty unless deviating):
# INGEST_CONTINUOUS_MS  scan cadence of the "continuous" trigger (default 30000)
# INGEST_SETTLE_MS      files modified more recently than this wait a scan (default 10000)
# INGEST_RUN_CAP        max admissions per ingest tick. Overrides BOTH adapters;
#                       unset lets each pick its own, because their costs differ
#                       in shape: a file admission decodes an image (per-ITEM,
#                       default 25) while a feed tick pays one catalog walk and
#                       one batched quote warm however many it admits
#                       (per-TICK, default 250).
# INGEST_FEED_CACHE_MS  connector-feed enumerated-window cache TTL (default 60000; 0 disables).
#                       A tick continuing a drain already in flight holds its
#                       window past this, up to 6h — a run is one point-in-time
#                       snapshot, and re-walking a metered catalog per tick is
#                       what this bound is protecting against, not encouraging.
# INGEST_FEED_CAP       OPTIONAL ration on how deep a feed enumerates. Unset
#                       (the default) means no app-side limit: a feed sees the
#                       whole catalog, because a capped window clogs — the
#                       ledger dedups downstream, so once the first N are
#                       ingested they keep filling the window and everything
#                       past N is permanently unreachable. Set this only to
#                       cap spend on a METERED catalog (crypto pays one
#                       request per 250 rows; ~74 for a full CoinGecko pass).
#                       Stocks costs nothing at any depth — one cached
#                       screener call serves it — so its bound is the
#                       provider's own FMP_UNIVERSE_ROWS, not this.
INGEST_CONTINUOUS_MS=
INGEST_SETTLE_MS=
INGEST_RUN_CAP=
INGEST_FEED_CACHE_MS=
INGEST_FEED_CAP=

# --- connectors (crypto/stocks data providers) ---
# CONNECTOR_TIMEOUT_MS       per-request budget for interactive provider calls
#                            (quotes/search — default 15000; they answer in <1s,
#                            fail fast protects the worker tick)
# CONNECTOR_BULK_TIMEOUT_MS  budget for bulk catalog computations (default
#                            60000 — FMP's company-screener answered sub-second
#                            when re-measured 2026-08-13; the budget is a hang
#                            detector, not an expected cost)
# FMP_UNIVERSE_ROWS          stocks universe depth: browse/feed/market-cap-rank
#                            ceiling (default 30000 — sized to hold the whole
#                            US-listed universe INCLUDING ADRs, ETFs and funds,
#                            with growth headroom; clamp 100–100000). One
#                            request either way — depth is free, measured.
# FMP_EXCHANGES              venues the universe covers (default
#                            "NASDAQ,NYSE,AMEX"). This is the tier's real
#                            boundary: non-US venue quotes are premium-gated,
#                            so listing them would only yield rows that fail
#                            on add. OTC IS quotable — add it here to browse
#                            it, at the cost of thousands more rows per
#                            screener fill (FMP meters trailing-30-day
#                            bandwidth per plan). OTC symbols stay addable by
#                            search regardless; this governs browse + feeds.
# Provider API keys live in the DB (Plugins page), not here. Rate limits are
# per-provider and key-aware (a keyless CoinGecko paces to its smaller shared
# pool); per-provider rpm/burst overrides are on the Plugins page. The crypto
# providers batch a refresh sweep into one request per provider, so a large
# board's cost is set by the SWEEP, not the coin count.
CONNECTOR_TIMEOUT_MS=
CONNECTOR_BULK_TIMEOUT_MS=
FMP_UNIVERSE_ROWS=

# --- database ---
POSTGRES_USER=gallery
POSTGRES_PASSWORD=gallery
POSTGRES_DB=gallery
