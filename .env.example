# Copy to .env (gitignored) and fill in. Every value has a working local default.

# --- site ---
# Real hostname enables automatic HTTPS via Caddy, e.g. SITE_ADDRESS=example.com
# Leave as :80 for plain-http local use.
SITE_ADDRESS=:80
# Published ports. Use high ports locally if 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
# Absolute URL used in minted invite links, e.g. https://example.com
BASE_URL=http://localhost
# Set to 0 when serving over plain http so auth cookies work.
COOKIE_SECURE=1

# --- app ---
# Seeded as the admin account on startup.
ADMIN_EMAIL=
# AI tagging (optional — the worker idles without a key; can also be set in the admin UI).
ANTHROPIC_API_KEY=
MODEL=
# Days to keep live-field movement history (written only on boards with
# "retag on new data" enabled). 0 keeps it forever.
SNAPSHOT_RETENTION_DAYS=90
# Days to keep tag-judgment history (deduped — only real judgment changes are
# stored, so this defaults to keeping it forever). 0 keeps it forever.
TAG_SNAPSHOT_RETENTION_DAYS=0

# --- automatic ingestion ---
# Watched folders live under ./ingest-root on the host (bind-mounted into the
# app at /data/ingest — boards pick a subfolder in the ingestion modal).
# Tunables (code owns the defaults; leave empty unless deviating):
# INGEST_CONTINUOUS_MS  scan cadence of the "continuous" trigger (default 30000)
# INGEST_SETTLE_MS      files modified more recently than this wait a scan (default 10000)
# INGEST_RUN_CAP        max admissions per worker tick (default 25)
INGEST_CONTINUOUS_MS=
INGEST_SETTLE_MS=
INGEST_RUN_CAP=

# --- database ---
POSTGRES_USER=gallery
POSTGRES_PASSWORD=gallery
POSTGRES_DB=gallery
